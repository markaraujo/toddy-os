[Unit]
Description=Toddy per-user native assistant broker
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.github.markaraujo.Toddy.Service
ExecStart=/usr/bin/python3 /usr/lib/toddy/broker/service.py
UMask=0077
LimitCORE=0
KillMode=control-group
TimeoutStopSec=15s
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target
