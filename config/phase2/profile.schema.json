{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "locale",
    "provider",
    "tools",
    "skills",
    "budgets",
    "memory",
    "automation",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "locale": {
      "enum": [
        "en",
        "pt-BR"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "adapter_id",
        "model_id",
        "connection_ref",
        "allow_remote_fallback"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deferred",
            "local",
            "remote"
          ]
        },
        "adapter_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "connection_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "allow_remote_fallback": {
          "const": false
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_deadline_seconds",
        "max_tool_calls",
        "max_retries",
        "max_context_tokens",
        "max_output_tokens",
        "remote_spending_enabled"
      ],
      "properties": {
        "task_deadline_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "remote_spending_enabled": {
          "type": "boolean"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_enabled",
        "retention_days"
      ],
      "properties": {
        "history_enabled": {
          "type": "boolean"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "workflow_ids"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workflow_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toddy profile v1 candidate \u2014 repository preparation",
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "mode": {
                "const": "deferred"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "adapter_id": {
                "type": "null"
              },
              "model_id": {
                "type": "null"
              },
              "connection_ref": {
                "type": "null"
              }
            }
          },
          "budgets": {
            "properties": {
              "remote_spending_enabled": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "mode": {
                "enum": [
                  "local",
                  "remote"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "adapter_id": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "connection_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "mode": {
                "const": "local"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "budgets": {
            "properties": {
              "remote_spending_enabled": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
