From a24aa940376154ad492867246adfb45a2e9b2428 Mon Sep 17 00:00:00 2001
From: "Dmitry V. Levin" <ldv@strace.io>
Date: Wed, 23 Sep 2026 11:00:00 +0000
Subject: [PATCH] pam_group: fix out-of-bounds read in is_same() wildcard
 matching

The is_same() function in pam_group has the same out-of-bounds read
as the one fixed in pam_time: when a group.conf token contains a
wildcard with a trailing suffix (e.g. "*admin"), the suffix pointer
underflows if the runtime string is shorter than the suffix.

Apply the same bounds check before subtracting.
---
 modules/pam_group/pam_group.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/modules/pam_group/pam_group.c b/modules/pam_group/pam_group.c
index 721afd5d4..e4dabe314 100644
--- a/modules/pam_group/pam_group.c
+++ b/modules/pam_group/pam_group.c
@@ -315,7 +315,13 @@ is_same (const pam_handle_t *pamh UNUSED,
      for (i=0; len > 0; ++i, --len) {
 	  if (b[i] != a[i]) {
 	       if (b[i++] == '*') {
-		    return (!--len || !strncmp(b+i,a+strlen(a)-len,len));
+		    size_t a_len;
+		    if (!--len)
+			return TRUE;
+		    a_len = strlen(a);
+		    if (a_len < (size_t) len)
+			return FALSE;
+		    return !strncmp(b + i, a + a_len - len, len);
 	       } else
 		    return FALSE;
 	  }
