From 66a099ead9604c511454cd7dfe8f420d868d6163 Mon Sep 17 00:00:00 2001
From: "Dmitry V. Levin" <ldv@strace.io>
Date: Wed, 23 Sep 2026 11:00:00 +0000
Subject: [PATCH] pam_time: fix out-of-bounds read in is_same() wildcard
 matching

When a time.conf token contains a wildcard with a trailing suffix
(e.g. "*admin"), is_same() computes a suffix pointer as
a + strlen(a) - len.  If the runtime string is shorter than the
suffix, this underflows the pointer and strncmp() reads out of
bounds.

Check that the runtime string is at least as long as the suffix
before subtracting, and return FALSE when it is not.

Reported-by: AISLE in partnership with Red Hat
---
 modules/pam_time/pam_time.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/modules/pam_time/pam_time.c b/modules/pam_time/pam_time.c
index 2b7e1c9ff..e345e5fcc 100644
--- a/modules/pam_time/pam_time.c
+++ b/modules/pam_time/pam_time.c
@@ -378,7 +378,13 @@ is_same(pam_handle_t *pamh UNUSED, const void *A, const char *b,
      for (i=0; len > 0; ++i, --len) {
 	  if (b[i] != a[i]) {
 	       if (b[i++] == '*') {
-		    return (!--len || !strncmp(b+i,a+strlen(a)-len,len));
+		    size_t a_len;
+		    if (!--len)
+			return TRUE;
+		    a_len = strlen(a);
+		    if (a_len < (size_t) len)
+			return FALSE;
+		    return !strncmp(b + i, a + a_len - len, len);
 	       } else
 		    return FALSE;
 	  }
