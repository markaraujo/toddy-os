+/* Validate identity fields before selecting a process representation. */
+static gboolean
+validate_process_details (GVariant *dict, GError **error)
+{
+  static const struct {
+    const gchar *key;
+    const GVariantType *type;
+  } fields[] = {
+    { "uid", G_VARIANT_TYPE_INT32 },
+    { "pid", G_VARIANT_TYPE_UINT32 },
+    { "start-time", G_VARIANT_TYPE_UINT64 },
+    { "pidfd", G_VARIANT_TYPE_HANDLE },
+  };
+  GVariantIter iter;
+  const gchar *key;
+  GVariant *value;
+  guint seen = 0;
+
+  g_variant_iter_init (&iter, dict);
+  while (g_variant_iter_next (&iter, "{&sv}", &key, &value))
+    {
+      for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+        if (g_str_equal (key, fields[i].key))
+          {
+            if ((seen & (1u << i)) ||
+                !g_variant_is_of_type (value, fields[i].type))
+              {
+                g_set_error (error, POLKIT_ERROR, POLKIT_ERROR_FAILED,
+                             "Invalid unix-process subject field `%s' (%s; type %s, expected %s)",
+                             key, (seen & (1u << i)) ? "duplicate" : "wrong type",
+                             g_variant_get_type_string (value),
+                             g_variant_type_peek_string (fields[i].type));
+                g_variant_unref (value);
+                return FALSE;
+              }
+            seen |= 1u << i;
+            break;
+          }
+      g_variant_unref (value);
+    }
+  return TRUE;
+}
