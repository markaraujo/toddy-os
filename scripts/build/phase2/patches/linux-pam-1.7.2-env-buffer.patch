From dc1a6009fe536f7f8d90a57fe2193441e81bbd7d Mon Sep 17 00:00:00 2001
From: Thorsten Kukuk <kukuk@suse.com>
Date: Tue, 26 May 2026 10:49:39 +0200
Subject: [PATCH] pam_env: fix check for buffer size (#975)

_strbuf_reserve() in modules/pam_env/pam_env.c can allocate insufficient
space when doubling the buffer, since it ignores the already used buffer
size.
---
 modules/pam_env/pam_env.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/modules/pam_env/pam_env.c b/modules/pam_env/pam_env.c
index 3158768e9..ab07801e5 100644
--- a/modules/pam_env/pam_env.c
+++ b/modules/pam_env/pam_env.c
@@ -550,7 +550,7 @@ _strbuf_reserve(struct string_buffer *buffer, size_t add)
   if (buffer->size == 0 && add < 64) {
     /* Start with 64 bytes if that's enough */
     s = 64;
-  } else if (buffer->size >= SIZE_MAX / 2 || buffer->size * 2 < add + 1) {
+  } else if (buffer->size >= SIZE_MAX / 2 || buffer->size * 2 < buffer->len + add + 1) {
     /* If doubling is not enough (or not possible), get as much as needed */
     s = buffer->len + add + 1;
   } else {
