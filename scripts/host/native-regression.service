[Unit]
Description=Toddy disposable native namespace regression probe
ConditionPathExists=!/etc/initrd-release
After=local-fs.target
OnSuccess=poweroff.target
OnFailure=poweroff.target

[Service]
Type=oneshot
Environment=PATH=/usr/bin:/usr/sbin LC_ALL=en_US.UTF-8 PYTHONDONTWRITEBYTECODE=1
LoadCredential=toddy.boot-probe
LoadCredential=toddy.boot-common
ExecStart=/usr/bin/python3 %d/toddy.boot-probe
TimeoutStartSec=840
StandardOutput=journal+console
StandardError=journal+console
